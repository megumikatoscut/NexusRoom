<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <Compile Include="..\..\src\NexusRoom.Host\Voice\OfflineVoiceModels.cs" Link="OfflineVoiceModels.cs" />
    <Compile Include="..\..\src\NexusRoom.Host\Voice\WindowsVoiceService.cs" Link="WindowsVoiceService.cs" />
    <Compile Include="..\..\src\NexusRoom.Host\Voice\WindowsVoiceActivity.cs" Link="WindowsVoiceActivity.cs" />
    <Compile Include="..\..\src\NexusRoom.Host\Desktop\WindowActivation.cs" Link="WindowActivation.cs" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Content Include="..\..\.local\voice-fixtures\models\**" Link="voice\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
